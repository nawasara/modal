{
    "name": "nawasara/modal",
    "description": "Reusable Blade and Livewire modal component for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "livewire",
        "modal",
        "blade-component"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/modal/issues",
        "source": "https://github.com/nawasara/modal"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Modal\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Modal\\ModalServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
